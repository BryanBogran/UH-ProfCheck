{
  "manifest_version": 3,
  "name": "UH ProfCheck",
  "version": "0.2.0",
  "description": "Professor ratings, grade history, section rankings, and optional dark mode for University of Houston enrollment.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.cougargrades.io/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://saprd.my.uh.edu/*"
      ],
      "js": [
        "src/theme.js"
      ],
      "css": [
        "src/dark.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://saprd.my.uh.edu/*"
      ],
      "js": [
        "src/config.js",
        "src/parse.js",
        "src/scoring.js",
        "src/content.js",
        "src/launcher.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-32.png"
      ],
      "matches": [
        "https://saprd.my.uh.edu/*"
      ]
    }
  ]
}
