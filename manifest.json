{
  "manifest_version": 3,
  "name": "Professor Overlay",
  "version": "0.1.0",
  "description": "Overlay RateMyProfessor and CougarGrades data onto a university enrollment page.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.cougargrades.io/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://saprd.my.uh.edu/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
